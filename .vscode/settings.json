{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  "editor.rulers": [240],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "files.exclude": {
    "**/node_modules": true,
    "dist": true,
    "tmp": true,
    "sandbox": true,
    ".codegraph": true,
    ".obsidian": true,
    ".claude": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "dist": true,
    "tmp": true,
    "sandbox": true,
    ".codegraph": true,
    ".obsidian": true,
    ".claude": true,
    "package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "dist/**": true,
    ".codegraph/**": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, tsconfig.json, eslint.config.js, dprint.json, vitest.config.ts, .editorconfig, .gitattributes, .gitignore",
    "AGENTS.md": "CLAUDE.md",
    "README.md": "LICENSE"
  }
}
