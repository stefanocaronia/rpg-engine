{
  "name": "rpg-engine",
  "version": "0.0.0",
  "private": true,
  "description": "A toolbox that lets a high-level AI run a tabletop RPG campaign: the AI tells the story, the tool remembers, rolls the dice and keeps the accounts.",
  "type": "module",
  "bin": {
    "rpg": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "packs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "rpg",
    "ttrpg",
    "ai",
    "game-master",
    "dice",
    "mcp"
  ],
  "author": "Stefano Caronia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanocaronia/rpg-engine.git"
  },
  "homepage": "https://github.com/stefanocaronia/rpg-engine#readme",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
