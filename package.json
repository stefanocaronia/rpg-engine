{
  "name": "rpg-engine",
  "version": "0.0.0",
  "private": true,
  "description": "A toolbox that lets a high-level AI run a tabletop RPG campaign: the AI tells the story, the tool remembers, rolls the dice and keeps the accounts.",
  "type": "module",
  "bin": {
    "rpg": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "systems",
    "extensions",
    "instructions"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "format": "eslint --fix . && dprint fmt",
    "lint": "eslint . && dprint check"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "rpg",
    "ttrpg",
    "ai",
    "game-master",
    "dice",
    "mcp"
  ],
  "author": "Stefano Caronia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanocaronia/rpg-engine.git"
  },
  "homepage": "https://github.com/stefanocaronia/rpg-engine#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/parser": "^8.71.0",
    "dprint": "^0.58.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
