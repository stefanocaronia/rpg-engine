{
  "name": "rpg-engine",
  "version": "0.8.0",
  "description": "Play a tabletop role-playing game with an AI as your game master: the AI tells the story; RPG Engine remembers the world, rolls the dice and keeps the accounts.",
  "type": "module",
  "bin": {
    "rpg": "dist/cli/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "rpg-engine": {
    "kind": "engine",
    "api": 7
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "systems",
    "instructions"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && tsc -p src/dashboard && node -e \"require('node:fs').cpSync('src/dashboard', 'dist/dashboard', { recursive: true, filter: (path) => !/[.](tsx?|py)$|tsconfig[.]json$|[^a-z-]style$/.test(path) })\" && node src/dashboard/style/join.mjs dist/dashboard/style.css",
    "dev": "tsc --watch",
    "demo": "npm run build && node --experimental-strip-types --no-warnings test/demo/dashboard.ts --ask --port 5760",
    "betasim": "npm run build && node --experimental-strip-types --no-warnings test/betasim/run.ts",
    "translate": "node --experimental-strip-types --no-warnings test/i18n/translate.ts",
    "test:downstream": "node --experimental-strip-types --no-warnings test/downstream/run.ts",
    "test": "vitest run",
    "format": "eslint --fix . && dprint fmt",
    "lint": "eslint . && dprint check && tsc -p tsconfig.test.json && tsc -p src/dashboard --noEmit",
    "docs": "node --experimental-strip-types --input-type=module -e \"import { writeFileSync } from 'node:fs'; import { commands } from './src/commands/index.ts'; import { commandReference } from './src/core/command-reference.ts'; writeFileSync('docs/commands.md', commandReference(commands));\""
  },
  "engines": {
    "node": ">=22.4"
  },
  "keywords": [
    "rpg",
    "ttrpg",
    "ai",
    "game-master",
    "dice",
    "mcp",
    "mcp-server",
    "tabletop",
    "role-playing",
    "solo-rpg",
    "5e",
    "claude-code",
    "codex"
  ],
  "author": {
    "name": "Stefano Caronia",
    "url": "https://stefanocaronia.it"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanocaronia/rpg-engine.git"
  },
  "homepage": "https://github.com/stefanocaronia/rpg-engine#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@typescript-eslint/parser": "^8.71.0",
    "betasim": "git+https://github.com/stefanocaronia/betasim.git",
    "dprint": "^0.58.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "playwright-core": "~1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "fflate": "^0.8.2",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "unpdf": "1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
